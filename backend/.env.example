PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/edubeacon
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:3000

# Signs admin session tokens for email+password login.
# Must be at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# Optional bootstrap for the Clerk OTP path only. Admin credentials
# themselves live in the `admins` collection — seed with:
#   npm run seed:admin -- <email> <password> "Full Name"
ADMIN_EMAILS=admin@yourdomain.com
