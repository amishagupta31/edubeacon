PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/edubeacon
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:3000

# Signs admin session tokens for email+password login.
# Must be at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# Optional bootstrap for the Clerk OTP path only. Admin credentials
# themselves live in the `admins` collection — seed with:
#   npm run seed:admin -- <email> <password> "Full Name"
ADMIN_EMAILS=admin@yourdomain.com

# ── Email (SMTP relay, e.g. Brevo) ──
# Leave SMTP_HOST empty to disable sending; emails are then logged to the
# console instead, which is useful in local development.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduBeacon <noreply@yourdomain.com>
MAIL_REPLY_TO=

# Optional. Adds a static map thumbnail to event emails. Without it the
# emails still show the full address and a "Get Directions" button.
# Enable "Maps Static API" at https://console.cloud.google.com/apis/library
GOOGLE_MAPS_API_KEY=
