# ───────────────────────────────────────────────────────────────
# Secrets — never commit these. They hold live MongoDB credentials
# and Clerk secret keys. Only .env.example (placeholders) is tracked.
# ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ── Dependencies ──
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js (frontend) ──
.next/
out/
build/
.vercel

# ── TypeScript / Node build output (backend) ──
dist/
*.tsbuildinfo
next-env.d.ts

# ── Logs ──
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Testing ──
coverage/
.nyc_output/

# ── Caches ──
.cache/
.turbo/
.eslintcache
.parcel-cache/

# ── Editors & OS ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Claude Code local state ──
.claude/settings.local.json
